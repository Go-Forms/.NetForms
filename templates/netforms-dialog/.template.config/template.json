{
  "$schema": "http://json.schemastore.org/template",
  "author": "NetForms contributors",
  "classifications": [
    "Common",
    "WinForms",
    "NetForms"
  ],
  "identity": "NetForms.Dialog.CSharp",
  "name": "NetForms Dialog",
  "description": "A dialog box: OK and Cancel buttons that close it with a DialogResult, a fixed border, no minimize or maximize box.",
  "shortName": "netforms-dialog",
  "sourceName": "Dialog1",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "Namespace": {
      "type": "parameter",
      "datatype": "string",
      "description": "The namespace of the new files. Default: the RootNamespace of the project."
    },
    "DefaultNamespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace"
    },
    "ActualNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Namespace",
        "fallbackVariableName": "DefaultNamespace"
      },
      "replaces": "NetFormsNamespace"
    }
  },
  "defaultName": "Dialog1",
  "preferDefaultName": true,
  "constraints": {
    "csharp-only": {
      "type": "project-capability",
      "args": "CSharp"
    }
  }
}